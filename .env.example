# Excellentia Arts Fiesta 2026 - Production Environment Configuration
# Deployment: Vercel / Railway / Render / Fly.io

# Server Port
PORT=3000
NODE_ENV=production

# Supabase Cloud PostgreSQL Database Configuration
# In Vercel, configure these under Settings -> Environment Variables
# Keep SUPABASE_SERVICE_ROLE_KEY strictly server-side (DO NOT expose in client code)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin & Camera Clearance Overrides (Optional - defaults to settings in database)
ADMIN_USERNAME=e26@gmail.com
ADMIN_PASSWORD=e26msoe
CAMERA_USERNAME=e26camera
CAMERA_PASSWORD=e26cam
